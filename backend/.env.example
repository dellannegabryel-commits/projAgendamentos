# =============================================================================
# VARIAVEIS DE AMBIENTE - Backend Agenda Facil
# =============================================================================
# Copie este arquivo para .env e ajuste os valores para seu ambiente local.
# EM PRODUCAO: gere valores seguros para todas as senhas e chaves.
# =============================================================================

# Server
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/agendamento

# Auth
JWT_SECRET=<GERAR-EM-PRODUCAO-minimo-32-caracteres>

# Default Admin (usado apenas no seed - apos primeiro setup, o banco gerencia)
DEFAULT_ADMIN_EMAIL=admin@agendafacil.com
DEFAULT_ADMIN_PASSWORD=admin

# WhatsApp / Evolution API
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_INSTANCE_NAME=mvp
WHATSAPP_API_KEY=<GERAR-EM-PRODUCAO>

# CORS (CSV de origens permitidas)
CORS_ORIGIN=http://localhost:3000
