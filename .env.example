# =============================================================================
# VARIAVEIS DE AMBIENTE - Agenda Facil
# =============================================================================
# Copie este arquivo para .env e ajuste os valores para seu ambiente local.
# EM PRODUCAO: gere valores seguros para todas as senhas e chaves.
# =============================================================================

# PostgreSQL - App Database
DB_USER=<GERAR-EM-PRODUCAO>
DB_PASSWORD=<GERAR-EM-PRODUCAO>
DB_NAME=agendamento
DB_PORT=5432

# PostgreSQL - Evolution Database
EVOLUTION_DB_USER=<GERAR-EM-PRODUCAO>
EVOLUTION_DB_PASSWORD=<GERAR-EM-PRODUCAO>
EVOLUTION_DB_NAME=evolution
EVOLUTION_DB_PORT=5433

# Backend
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@db:5432/agendamento
BACKEND_PORT=3000
WHATSAPP_API_URL=http://evolution:8080
WHATSAPP_INSTANCE_NAME=mvp
WHATSAPP_API_KEY=<GERAR-EM-PRODUCAO>

# Evolution API
EVOLUTION_DATABASE_URI=postgresql://<EVOLUTION_DB_USER>:<EVOLUTION_DB_PASSWORD>@evolution-db:5432/evolution

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Security
JWT_SECRET=<GERAR-EM-PRODUCAO-minimo-32-caracteres>
CORS_ORIGIN=http://localhost:3000
